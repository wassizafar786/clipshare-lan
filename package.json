{
  "name": "clipshare-lan",
  "version": "0.4.3",
  "description": "Share clipboard and files across Mac and Windows on the same Wi‑Fi with pairing codes",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/smoke-protocol.mjs && node scripts/smoke-semver.mjs && node scripts/smoke-history.mjs && node scripts/smoke-connect.mjs && node scripts/smoke-dialback.mjs",
    "lint": "echo lint-ok",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "release:build": "node scripts/publish-release.mjs",
    "aidlc": "bun ../aidlc-fast/src/cli.ts"
  },
  "keywords": [
    "clipboard",
    "lan",
    "tray",
    "pairing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "aidlc-fast": "^0.6.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "build": {
    "appId": "com.clipshare.lan",
    "productName": "ClipShare LAN",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ClipShare-LAN-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "ClipShare-LAN-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "ClipShare connects to other computers on your Wi-Fi to sync the clipboard and files."
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wassizafar786",
        "repo": "clipshare-lan"
      }
    ]
  }
}
