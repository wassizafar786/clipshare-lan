{
  "name": "clipshare-lan",
  "version": "0.1.0",
  "description": "Share clipboard across Mac and Windows on the same Wi‑Fi with pairing codes",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/smoke-protocol.mjs",
    "lint": "echo lint-ok",
    "aidlc": "bun ../aidlc-fast/src/cli.ts"
  },
  "keywords": [
    "clipboard",
    "lan",
    "tray",
    "pairing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "aidlc-fast": "^0.6.0",
    "electron": "^35.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  }
}
